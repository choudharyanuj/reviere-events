---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Split from '../components/Split.astro';
import Timeline from '../components/Timeline.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { aboutPage } from '../data/site';
import portrait from '../assets/images/about-portrait.jpg';
import contemporary from '../assets/images/contemporary.jpg';
import bollyhop from '../assets/images/bollyhop.jpg';
import salsa from '../assets/images/salsa.jpg';

const { hero, bio, dance, quote, journey, cta } = aboutPage;
// Which photo each dance-style chip reveals (Bachata, a partner dance, shares the couple shot).
const styleImage = [0, 1, 2, 2];
const danceImages = [contemporary, bollyhop, salsa];
const ringText = 'REVIERE EVENTS • PATNA, BIHAR • REVIERE EVENTS • PATNA, BIHAR • ';
---
<Base page="about">
  <PageHero title={hero.title} subtitle={hero.subtitle} crumb={hero.crumb} />

  <section class="section" id="bio">
    <div class="shell grid gap-16 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <div class="relative md:sticky md:top-[calc(var(--nav-h)+2.5rem)]" data-reveal="scale">
          <div class="portrait-frame sheen relative aspect-[3/4] overflow-hidden rounded-[2rem] bg-card" data-tilt="soft">
            <Picture src={portrait} alt={bio.imageAlt} formats={['avif', 'webp']} widths={[420, 640, 896]} sizes="(min-width: 768px) 40vw, 92vw" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
          </div>
          <div class="absolute -right-3 -bottom-10 h-32 w-32 md:-right-10 md:h-40 md:w-40" aria-hidden="true" data-spin-on-scroll>
            <svg viewBox="0 0 200 200" class="h-full w-full drop-shadow-[0_20px_40px_rgba(255,61,129,0.35)]">
              <defs>
                <path id="ring-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
                <linearGradient id="ring-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#ff3d81" /><stop offset="0.55" stop-color="#ff7a2f" /><stop offset="1" stop-color="#ffc247" />
                </linearGradient>
              </defs>
              <circle cx="100" cy="100" r="98" fill="url(#ring-grad)" />
              <text fill="#0a0a0a" font-size="12.6" letter-spacing="3.1" font-family="Geist Mono Variable, monospace" font-weight="600">
                <textPath href="#ring-path">{ringText}</textPath>
              </text>
              <text x="100" y="114" text-anchor="middle" fill="#0a0a0a" font-family="Clash Display, sans-serif" font-weight="600" font-size="40">RE</text>
            </svg>
          </div>
        </div>
      </div>

      <div class="md:col-span-7 md:pl-10">
        <p class="eyebrow" data-reveal>{bio.eyebrow}</p>
        <Split as="h2" text={bio.title} class="h2 mt-6" />
        <div class="mt-10 space-y-6 text-[1.0625rem] leading-[1.75] text-muted">
          {bio.paragraphs.map((p, i) => <p data-reveal style={`--d:${i * 80}ms`}>{p.map(([t, em]) => (em ? <strong class="font-medium text-fg">{t}</strong> : t))}</p>)}
        </div>

        <ul class="mt-14 grid grid-cols-3 border-y border-white/[0.08]">
          {
            bio.stats.map((s, i) => (
              <li class:list={['py-8', i > 0 && 'border-l border-white/[0.08] pl-5 md:pl-8']} data-reveal style={`--d:${i * 90}ms`}>
                <span class="text-grad block font-display text-[clamp(2.6rem,4.8vw,4.4rem)] leading-none font-semibold">{s.value}</span>
                <span class="mt-3 block font-mono text-[0.64rem] tracking-[0.14em] text-muted">{s.label}</span>
              </li>
            ))
          }
        </ul>

        <div class="dance-card mt-14 grid overflow-hidden rounded-[2rem] md:grid-cols-5" data-reveal data-dance>
          <div class="p-8 md:col-span-3 md:p-10">
            <h3 class="font-display text-[clamp(1.6rem,2.4vw,2.2rem)] leading-[1.05] font-semibold tracking-tight">{dance.title}</h3>
            <p class="mt-5 text-[0.98rem] leading-relaxed text-muted">{dance.paragraph.map(([t, em]) => (em ? <strong class="font-medium text-orange">{t}</strong> : t))}</p>
            <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Dance styles">
              {dance.styles.map((st, i) => <button type="button" class="dance-chip chip" aria-pressed={i === 0 ? 'true' : 'false'} data-dance-chip={styleImage[i]}>{st}</button>)}
            </div>
          </div>
          <div class="relative min-h-[18rem] md:col-span-2 md:min-h-0">
            {danceImages.map((im, i) => <Picture src={im} alt="" formats={['avif', 'webp']} widths={[360, 560]} sizes="(min-width: 768px) 22vw, 92vw" loading="lazy" class={`dance-img absolute inset-0 h-full w-full object-cover${i === 0 ? ' is-active' : ''}`} data-dance-img={i} />)}
            <div class="absolute inset-0 bg-linear-to-r from-card/70 to-transparent" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote: words light up as you scroll, under stage lights -->
  <section class="section relative isolate overflow-clip bg-bg-2" data-spotlight>
    <canvas class="absolute inset-0 -z-10 h-full w-full opacity-0 transition-opacity duration-[1400ms]" data-spotlight-canvas aria-hidden="true"></canvas>
    <div class="shell py-10 text-center md:py-20">
      <Icon name="Quote" class="mx-auto h-10 w-10 text-orange" stroke={1.25} />
      <blockquote class="mx-auto mt-10 max-w-[18ch] font-display text-[clamp(2.3rem,6vw,5.6rem)] leading-[1] font-semibold tracking-tight" data-scrub-words>
        <span class="text-grad">“</span>{quote.text.split(' ').map((w) => <span class="sw">{w} </span>)}<span class="text-grad">”</span>
      </blockquote>
      <p class="mt-12 font-mono text-sm tracking-[0.2em] text-orange uppercase" data-reveal>{quote.by}</p>
    </div>
  </section>

  <Timeline eyebrow={journey.eyebrow} title={journey.title} subtitle={journey.subtitle} steps={journey.steps} />

  <div class="h-6 md:h-12"></div>
  <CtaBanner title={cta.title} text={cta.text} primary={cta.primary} secondary={cta.secondary} />
  <div class="h-10 md:h-16"></div>
</Base>

<style>
  .portrait-frame { box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 40px 100px -40px rgb(255 61 129 / 0.45); }
  .dance-card { background: linear-gradient(140deg, rgb(255 61 129 / 0.10), rgb(139 92 246 / 0.06) 60%), var(--color-card); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  .dance-chip:hover, .dance-chip[aria-pressed='true'] { background: var(--grad); color: #0a0a0a; box-shadow: none; }
  .dance-img { opacity: 0; scale: 1.08; transition: opacity 0.9s var(--ease-expo), scale 1.4s var(--ease-expo); }
  .dance-img.is-active { opacity: 1; scale: 1; }
  .sw { display: inline; white-space: pre-wrap; color: rgb(255 255 255 / 0.12); transition: color 0.4s; }
  html:not(.js) .sw, .sw.is-lit { color: var(--color-fg); }
</style>
