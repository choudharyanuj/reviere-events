---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import SectionHead from '../components/SectionHead.astro';
import VendorGrid from '../components/VendorGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { home } from '../data/site';
import { u } from '../lib/url';
import { scenes, type SceneKey } from '../lib/images';

const { hero, stats, services, vendors, highlights, testimonials, cta } = home;
const img = (k: string) => scenes[k as SceneKey];
---
<Base page="home">
  <!-- ───────── Hero ───────── -->
  <section class="relative isolate overflow-hidden" data-hero3d="home" data-cursor="Spin">
    <div class="aurora absolute inset-0 -z-20" aria-hidden="true"></div>
    <div class="hero-beams absolute inset-0 -z-20" aria-hidden="true"></div>
    <canvas class="absolute inset-0 -z-10 h-full w-full opacity-0 transition-opacity duration-[1800ms]" data-hero-canvas aria-hidden="true"></canvas>
    <div class="hero-scroll shell flex min-h-[100svh] flex-col justify-end pt-[calc(var(--nav-h)+3rem)] pb-8 md:pt-[calc(var(--nav-h)+1.5rem)] md:pb-10">
      <p class="eyebrow hero-fade max-w-[19rem] sm:max-w-none" style="--d:150ms">{hero.eyebrow}</p>
      <Split hero as="h1" class="h-display mt-6 md:mt-8" lines={[{ text: hero.title[0] }, { text: hero.title[1], class: 'text-grad pl-[0.5em] md:pl-[1.2em]' }]} />
      <div class="mt-7 grid gap-7 md:mt-[min(3.5rem,4svh)] md:grid-cols-12 md:items-end">
        <div class="md:col-span-6">
          <p class="hero-fade font-display text-[1.75rem] leading-tight font-medium tracking-tight md:text-[clamp(1.6rem,min(2.6vw,4.5svh),2.4rem)]" style="--d:520ms">{hero.tagline}</p>
          <p class="hero-fade mt-4 max-w-md text-[0.98rem] leading-relaxed text-muted" style="--d:620ms">{hero.description}</p>
        </div>
        <div class="hero-fade flex flex-col gap-3 sm:flex-row md:col-span-6 md:justify-end" style="--d:740ms">
          <a href={u(hero.primary.href)} class="btn btn-lg btn-grad" data-magnetic>
            <span>{hero.primary.label}</span>
            <Icon name="ArrowUpRight" class="btn-icon" />
          </a>
          <button type="button" class="btn btn-lg btn-ghost" data-wa={hero.secondary.wa} data-magnetic>
            <BrandIcon name="whatsapp" class="h-[18px] w-[18px]" />
            <span>{hero.secondary.label}</span>
          </button>
        </div>
      </div>
      <div class="hero-fade mt-10 flex items-center justify-between pr-16 font-mono text-[0.68rem] tracking-[0.16em] text-muted uppercase md:mt-[min(3.5rem,4.5svh)] md:pr-24" style="--d:950ms">
        <span class="flex items-center gap-3"><span class="scroll-cue" aria-hidden="true"></span>Scroll</span>
        <span class="hidden items-center gap-2 sm:flex" data-hero-hint><Icon name="Hand" class="h-4 w-4" />Drag to spin · Tap for petals</span>
      </div>
    </div>
  </section>

  <!-- ───────── Service ticker ───────── -->
  <svg width="0" height="0" class="absolute" aria-hidden="true"><defs><linearGradient id="spark" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff3d81" /><stop offset=".55" stop-color="#ff7a2f" /><stop offset="1" stop-color="#ffc247" /></linearGradient></defs></svg>
  <section class="relative overflow-hidden border-y border-white/[0.07] py-6 md:py-9" aria-label="Our services">
    <div class="marquee-skew" data-marquee>
      <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
        {
          [0, 1].map((k) => (
            <ul class="flex shrink-0 items-center" aria-hidden={k === 1 ? 'true' : undefined}>
              {services.items.map((s, i) => (
                <li class="flex items-center">
                  <span class:list={['marquee-word px-5 font-display text-[clamp(2rem,5.4vw,5rem)] leading-none font-semibold tracking-tight uppercase md:px-9', i % 2 === 1 && 'is-outline']}>{s.title}</span>
                  <svg class="h-[clamp(1.1rem,2.4vw,2.2rem)] w-[clamp(1.1rem,2.4vw,2.2rem)] shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="url(#spark)" d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12C6.4 11.4 11.4 6.4 12 0Z" /></svg>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────── Stats ───────── -->
  <section class="shell" aria-label="Reviere Events in numbers">
    <ul class="grid grid-cols-2 md:grid-cols-4">
      {
        stats.map((s, i) => (
          <li class:list={['stat group px-1 py-10 md:px-8 md:py-16', i % 2 === 1 && 'border-l border-white/[0.07] pl-6', i >= 2 && 'border-t border-white/[0.07] md:border-t-0', i === 2 && 'md:border-l md:pl-8']} data-reveal style={`--d:${i * 90}ms`}>
            <span class="block font-display text-[clamp(3.75rem,7.5vw,7rem)] leading-none font-semibold tracking-tight tabular-nums transition-colors duration-500 group-hover:text-orange" data-counter={s.value}>{s.value}</span>
            <span class="mt-3 block font-mono text-[0.72rem] tracking-[0.12em] text-muted uppercase">{s.label}</span>
          </li>
        ))
      }
    </ul>
    <div class="hairline"></div>
  </section>

  <!-- ───────── Services (interactive index with cursor-following previews) ───────── -->
  <section class="section" id="services">
    <div class="shell">
      <SectionHead eyebrow={services.eyebrow} title={services.title} subtitle={services.subtitle} />
      <ul class="mt-16 border-t border-white/[0.08] md:mt-20" data-accordion>
        {
          services.items.map((s, i) => (
            <li class:list={['svc border-b border-white/[0.08]', i === 0 && 'is-open']} data-reveal>
              <h3>
                <button type="button" class="svc-head group flex w-full items-center gap-4 py-6 text-left md:gap-8 md:py-8" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`svc-${i}`} id={`svc-h-${i}`} data-acc-trigger>
                  <span class="svc-num w-8 shrink-0 font-mono text-xs text-faint tabular-nums transition-colors duration-500 md:w-12">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-title flex-1 font-display text-[clamp(1.8rem,4.2vw,4rem)] leading-[1] font-semibold tracking-tight uppercase transition-[transform,opacity,color] duration-700 ease-(--ease-expo)">{s.title}</span>
                  <span class="svc-icon hidden h-14 w-14 shrink-0 place-items-center rounded-full ring-1 ring-white/15 transition-[background,color,transform] duration-700 ease-(--ease-expo) md:grid">
                    <Icon name={s.icon} class="h-[22px] w-[22px]" />
                  </span>
                  <span class="svc-plus relative grid h-11 w-11 shrink-0 place-items-center rounded-full bg-fg text-bg" aria-hidden="true">
                    <span class="absolute h-px w-4 bg-current"></span>
                    <span class="svc-plus-v absolute h-4 w-px bg-current transition-transform duration-500 ease-(--ease-expo)"></span>
                  </span>
                </button>
              </h3>
              <div id={`svc-${i}`} class="svc-body grid" role="region" aria-labelledby={`svc-h-${i}`}>
                <div class="overflow-hidden">
                  <div class="grid gap-8 pb-10 md:grid-cols-12 md:gap-10 md:pb-14 md:pl-20">
                    <div class="svc-media overflow-hidden rounded-2xl md:col-span-5 lg:col-span-4">
                      <Picture
                        src={img(s.image)}
                        alt={s.title}
                        formats={['avif', 'webp']}
                        widths={[480, 800, 1100]}
                        sizes="(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 92vw"
                        loading="lazy"
                        class="aspect-[4/3] h-full w-full object-cover"
                      />
                    </div>
                    <div class="flex flex-col gap-8 md:col-span-7 lg:col-span-8">
                      <p class="max-w-xl text-lg leading-relaxed text-muted">{s.desc}</p>
                      <ul class="grid gap-3 sm:grid-cols-2">
                        {s.points.map((p) => (
                          <li class="flex items-start gap-3 text-[0.98rem]">
                            <Icon name="Check" class="mt-1 h-4 w-4 shrink-0 text-orange" stroke={2} />
                            {p}
                          </li>
                        ))}
                      </ul>
                      <div>
                        <button type="button" class="btn btn-ghost" data-wa={s.wa} data-magnetic>
                          <BrandIcon name="whatsapp" class="h-4 w-4" />
                          <span>{s.cta}</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────── Vendors ───────── -->
  <VendorGrid eyebrow={vendors.eyebrow} title={vendors.title} subtitle={vendors.subtitle} items={vendors.items} cta={{ label: vendors.cta, wa: vendors.wa }} />

  <!-- ───────── Highlights (drag gallery) ───────── -->
  <section class="section overflow-x-clip" id="highlights" data-gallery>
    <div class="gal-stage">
    <div class="shell">
      <SectionHead eyebrow={highlights.eyebrow} title={highlights.title} subtitle={highlights.subtitle} />
      <div class="gal-arrows mt-8 flex items-center justify-end gap-2 lg:-mt-12" data-reveal>
        <button type="button" class="gal-btn" aria-label="Previous highlight" data-gal-prev><Icon name="ArrowLeft" class="h-5 w-5" /></button>
        <button type="button" class="gal-btn" aria-label="Next highlight" data-gal-next><Icon name="ArrowRight" class="h-5 w-5" /></button>
      </div>
    </div>
    <div class="no-scrollbar mt-8 flex snap-x lg:mt-6 snap-mandatory scroll-px-(--gutter) gap-4 overflow-x-auto overflow-y-hidden overscroll-x-contain px-(--gutter) md:snap-none md:gap-6" data-gal-track data-cursor="Drag" tabindex="0" aria-label="Featured event highlights">
      {
        highlights.items.map((h, i) => (
          <figure class:list={['gal-card group relative h-[min(70svh,620px)] shrink-0 lg:h-[min(54svh,560px)] snap-start overflow-hidden rounded-[1.75rem] bg-card', i === 0 ? 'w-[86vw] md:w-[62vw] lg:w-[50vw]' : 'w-[74vw] sm:w-[46vw] lg:w-[29vw]']} data-reveal style={`--d:${i * 90}ms`}>
            <Picture
              src={img(h.image)}
              alt={h.alt}
              formats={['avif', 'webp']}
              widths={i === 0 ? [640, 1024, 1536] : [480, 720, 1024]}
              sizes={i === 0 ? '(min-width: 1024px) 50vw, (min-width: 768px) 62vw, 86vw' : '(min-width: 1024px) 29vw, (min-width: 640px) 46vw, 74vw'}
              loading="lazy"
              class="gal-img absolute inset-0 h-full w-[115%] max-w-none object-cover"
              draggable="false"
            />
            <div class="absolute inset-0 bg-linear-to-t from-bg/90 via-bg/10 to-transparent" aria-hidden="true"></div>
            <figcaption class="absolute inset-x-0 bottom-0 p-6 md:p-8">
              <span class="chip glass font-mono text-[0.68rem] tracking-[0.12em] uppercase">{h.tag}</span>
              <h3 class="mt-4 font-display text-[1.9rem] leading-[0.95] font-semibold tracking-tight uppercase transition-transform duration-700 ease-(--ease-expo) group-hover:-translate-y-1 md:text-[2.4rem]">{h.title}</h3>
            </figcaption>
          </figure>
        ))
      }
      <div class="w-px shrink-0" aria-hidden="true"></div>
    </div>
    <div class="shell mt-8 lg:mt-6">
      <div class="relative h-px bg-white/10" aria-hidden="true">
        <div class="absolute inset-y-0 left-0 w-1/4 origin-left" style="background: var(--grad)" data-gal-progress></div>
      </div>
    </div>
    </div>
  </section>

  <!-- ───────── Testimonials ───────── -->
  <section class="section bg-bg-2" id="testimonials">
    <div class="shell">
      <SectionHead eyebrow={testimonials.eyebrow} title={testimonials.title} subtitle={testimonials.subtitle} />
      <div class="mt-16 grid gap-12 md:mt-20 md:grid-cols-12" data-testimonials>
        <div class="grid touch-pan-y md:col-span-8 lg:col-span-9" data-t-stage aria-live="polite">
          {
            testimonials.items.map((t, i) => (
              <figure class:list={['t-slide col-start-1 row-start-1', i === 0 && 'is-active']} data-t-slide aria-hidden={i === 0 ? 'false' : 'true'}>
                <blockquote class="font-display text-[clamp(1.7rem,3.3vw,3.1rem)] leading-[1.12] font-medium tracking-tight">
                  <span class="text-grad">“</span>
                  {t.quote.split(' ').map((w, wi) => <span class="tw" style={`--i:${wi}`}>{w} </span>)}
                  <span class="text-grad">”</span>
                </blockquote>
                <figcaption class="t-meta mt-10 flex items-center gap-4">
                  <span class="grid h-12 w-12 place-items-center rounded-full font-mono text-sm font-semibold text-bg" style="background: var(--grad)">{t.initials}</span>
                  <span>
                    <span class="block font-medium">{t.name}</span>
                    <span class="block font-mono text-xs text-muted">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="flex gap-2 md:col-span-4 md:flex-col md:justify-end lg:col-span-3" role="tablist" aria-label="Client testimonials">
          {
            testimonials.items.map((t, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} class="t-tab relative flex flex-1 items-center gap-3 overflow-hidden rounded-2xl p-3 text-left ring-1 ring-white/10 transition-[background,box-shadow] duration-500 md:flex-none" data-t-tab={i}>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/[0.06] font-mono text-xs">{t.initials}</span>
                <span class="hidden min-w-0 sm:block">
                  <span class="block truncate text-sm font-medium">{t.name}</span>
                  <span class="block truncate font-mono text-[0.68rem] text-muted">{t.role}</span>
                </span>
                <span class="t-progress absolute bottom-0 left-0 h-[2px] w-full origin-left" style="background: var(--grad)" aria-hidden="true"></span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <div class="h-6 md:h-12"></div>
  <CtaBanner title={cta.title} text={cta.text} primary={cta.primary} secondary={cta.secondary} />
  <div class="h-10 md:h-16"></div>
</Base>

<style>
  .hero-beams {
    background:
      conic-gradient(from 168deg at 70% -10%, transparent 0deg, rgb(255 61 129 / 0.10) 8deg, transparent 18deg),
      conic-gradient(from 186deg at 30% -10%, transparent 0deg, rgb(139 92 246 / 0.10) 7deg, transparent 16deg);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
  }
  .scroll-cue { position: relative; width: 1px; height: 2.25rem; background: rgb(255 255 255 / 0.15); overflow: hidden; }
  .scroll-cue::after { content: ''; position: absolute; inset: 0; background: var(--grad); animation: cue 2.2s var(--ease-expo) 5; }
  .is-offscreen .scroll-cue::after { animation-play-state: paused; }
  @keyframes cue { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }

  /* Ticker */
  [data-marquee].is-offscreen .animate-marquee { animation-play-state: paused; }
  .marquee-word.is-outline { color: transparent; -webkit-text-stroke: 1px rgb(255 255 255 / 0.45); }
  .marquee-word { transition: color 0.4s; }
  .marquee-word:hover { color: var(--color-orange); -webkit-text-stroke: 0; }

  /* Services index */
  .svc-body { grid-template-rows: 0fr; transition: grid-template-rows 0.9s var(--ease-expo); }
  html:not(.js) .svc-body, .svc.is-open .svc-body { grid-template-rows: 1fr; }
  .svc-head[aria-expanded='true'] .svc-plus-v { transform: rotate(90deg); }
  .svc-head[aria-expanded='true'] .svc-num { color: var(--color-orange); }
  .svc-head[aria-expanded='true'] .svc-icon { background: var(--grad); color: #0a0a0a; }
  @media (hover: hover) {
    .svc-head:hover .svc-title { transform: translateX(1rem); }
    .svc-head:hover .svc-icon { transform: rotate(-14deg) scale(1.06); }
    [data-accordion]:has(.svc-head:hover) .svc:not(:has(.svc-head:hover)) .svc-title { opacity: 0.28; }
  }
  [data-accordion] { overflow-anchor: none; }
  /* The service photo eases in inside its own row when the row opens; nothing floats over the titles. */
  .svc-media img { opacity: 0; scale: 1.06; transition: opacity 0.6s var(--ease-expo) 0.15s, scale 1.1s var(--ease-expo) 0.15s; }
  .svc.is-open .svc-media img, html:not(.js) .svc-media img { opacity: 1; scale: 1; }

  /* Gallery. On desktop it becomes an Apple-style pinned scene: the stage sticks while the page scrolls
     through a runway, and that vertical scroll moves the photos sideways (CSS scroll-driven animation,
     computed by the browser in step with the scroll). Phones and tablets keep the swipeable strip. */
  @supports (animation-timeline: view()) {
    @media (min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      [data-gallery].is-pinned { view-timeline-name: --gal; view-timeline-axis: block; view-timeline-inset: 0px; height: calc(100svh + var(--gal-run, 0px)); padding-block: 0; }
      .is-pinned .gal-stage { position: sticky; top: 0; height: 100svh; display: flex; flex-direction: column; justify-content: center; }
      .is-pinned [data-gal-track] { overflow: visible; scroll-snap-type: none; cursor: auto; animation-name: gal-x; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --gal; animation-range: contain 0% contain 100%; }
      .is-pinned .gal-arrows { visibility: hidden; }
      .is-pinned [data-gal-progress] { width: 100% !important; animation-name: gal-progress; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: --gal; animation-range: contain 0% contain 100%; }
    }
  }
  @keyframes gal-x { to { transform: translate3d(calc(-1 * var(--gal-run, 0px)), 0, 0); } }
  @keyframes gal-progress { from { transform: scaleX(0.12); } to { transform: scaleX(1); } }
  .gal-btn { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16); transition: background 0.5s var(--ease-expo), color 0.5s var(--ease-expo); }
  .gal-btn:hover { background: var(--color-fg); color: #0a0a0a; }
  [data-gal-track].is-dragging { scroll-snap-type: none; cursor: grabbing; }
  [data-gal-track].is-dragging * { pointer-events: none; }
  .gal-img { transform: translateX(var(--px, -6%)); transition: scale 1.4s var(--ease-expo); }
  .gal-card:hover .gal-img { scale: 1.05; }

  /* Testimonials */
  .t-slide { visibility: hidden; }
  .t-slide.is-active { visibility: visible; }
  .t-slide .tw { display: inline-block; white-space: pre; opacity: 0; transform: translateY(0.3em); transition: opacity 0.6s var(--ease-expo), transform 0.8s var(--ease-expo); }
  .t-slide.is-active .tw { opacity: 1; transform: none; transition-delay: calc(var(--i) * 18ms); }
  .t-progress { transform: scaleX(0); }
  .t-tab[aria-selected='true'] .t-progress { animation: t-progress 7s linear forwards; }
  [data-testimonials].is-paused .t-progress { animation-play-state: paused; }
  @keyframes t-progress { to { transform: scaleX(1); } }
  .t-slide .t-meta { opacity: 0; transform: translateY(10px); transition: opacity 0.6s, transform 0.8s var(--ease-expo); }
  .t-slide.is-active .t-meta { opacity: 1; transform: none; transition-delay: 0.45s; }
  html:not(.js) .t-slide { visibility: visible; position: static; }
  html:not(.js) .t-slide .tw, html:not(.js) .t-slide .t-meta { opacity: 1; transform: none; }
  .t-tab[aria-selected='true'] { background: rgb(255 255 255 / 0.06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18); }
</style>
