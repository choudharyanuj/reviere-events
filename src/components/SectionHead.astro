---
import Split from './Split.astro';
interface Props { eyebrow: string; title: string; subtitle?: string; class?: string; titleId?: string }
const { eyebrow, title, subtitle, class: cls, titleId } = Astro.props;
---
<div class:list={['grid gap-8 md:grid-cols-12 md:items-end', cls]}>
  <div class="md:col-span-7">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <Split as="h2" text={title} class="h2 mt-6" id={titleId} />
  </div>
  {subtitle && <p class="lede md:col-span-5 md:justify-self-end md:pb-2" data-reveal style="--d:120ms">{subtitle}</p>}
</div>
