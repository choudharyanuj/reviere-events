---
interface Props { class?: string }
const { class: cls = 'h-10 w-10' } = Astro.props;
---
<span class:list={['relative grid shrink-0 place-items-center rounded-full bg-ink text-champagne', cls]} aria-hidden="true">
  <span class="absolute inset-[3px] rounded-full ring-1 ring-champagne/50"></span>
  <span class="font-serif text-[0.95em] leading-none tracking-tight">RE</span>
</span>
