---
interface Props { class?: string }
const { class: cls = 'h-10 w-10' } = Astro.props;
---
<span class:list={['relative grid shrink-0 place-items-center overflow-hidden rounded-full', cls]} aria-hidden="true">
  <span class="mono-ring absolute -inset-1/2"></span>
  <span class="absolute inset-[1.5px] rounded-full bg-bg"></span>
  <span class="relative font-display text-[0.92em] font-semibold tracking-tight">RE</span>
</span>
<style>
  /* Spins only while the logo is hovered, so the page can sit idle. */
  .mono-ring { background: conic-gradient(from 0deg, var(--color-pink), var(--color-orange), var(--color-amber), var(--color-violet), var(--color-pink)); animation: mono-spin 6s linear infinite paused; }
  :global(.group:hover) .mono-ring { animation-play-state: running; }
  @keyframes mono-spin { to { transform: rotate(360deg); } }
</style>
