---
import Split from './Split.astro';
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import { u } from '../lib/url';
interface Props { title: string; text: string; primary: { label: string; wa: string }; secondary: { label: string; href: string } }
const { title, text, primary, secondary } = Astro.props;
---
<section class="shell py-6 md:py-12">
  <div class="cta relative isolate overflow-hidden rounded-[2rem] px-6 py-24 text-center md:rounded-[3rem] md:py-40" data-spotlight>
    <div class="cta-bg absolute inset-0 -z-20" aria-hidden="true"></div>
    <canvas class="absolute inset-0 -z-10 h-full w-full opacity-0 transition-opacity duration-[1400ms]" data-spotlight-canvas aria-hidden="true"></canvas>
    <Split as="h2" text={title} class="h1 mx-auto max-w-[15ch]" />
    <p class="lede mx-auto mt-8" data-reveal style="--d:200ms">{text}</p>
    <div class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal style="--d:320ms">
      <button type="button" class="btn btn-lg btn-grad" data-wa={primary.wa} data-magnetic>
        <BrandIcon name="whatsapp" class="h-5 w-5" />
        <span>{primary.label}</span>
      </button>
      <a href={u(secondary.href)} class="btn btn-lg btn-ghost" data-magnetic>
        <span>{secondary.label}</span>
        <Icon name="ArrowRight" class="btn-icon no-rotate" />
      </a>
    </div>
  </div>
</section>
<style>
  .cta { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  .cta-bg {
    background:
      radial-gradient(60% 80% at 50% 120%, rgb(255 61 129 / 0.35), transparent 70%),
      radial-gradient(40% 60% at 15% -10%, rgb(139 92 246 / 0.30), transparent 70%),
      radial-gradient(40% 60% at 85% -10%, rgb(255 122 47 / 0.22), transparent 70%),
      var(--color-card);
  }
</style>
