---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
interface Props { eyebrow: string; title: string; subtitle: string; items: { icon: string; title: string; desc: string }[]; cta?: { label: string; wa: string } }
const { eyebrow, title, subtitle, items, cta } = Astro.props;
---
<section class="section relative overflow-hidden bg-bg-2">
  <div class="aurora pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
  <div class="shell relative">
    <SectionHead eyebrow={eyebrow} title={title} subtitle={subtitle} />
    <ul class="mt-12 grid grid-cols-2 gap-2.5 sm:gap-3 md:mt-16 lg:grid-cols-4" data-glow-group>
      {
        items.map((v, i) => (
          <li class="glow-tile group flex min-h-[12.5rem] flex-col rounded-[1.4rem] bg-white/[0.025] p-4.5 sm:min-h-[15.5rem] sm:rounded-[1.75rem] sm:p-7 md:p-8" data-reveal style={`--d:${(i % 4) * 80}ms`}>
            <div class="flex items-start justify-between">
              <span class="vendor-icon grid h-10 w-10 place-items-center rounded-xl text-fg transition-transform duration-700 ease-(--ease-expo) group-hover:scale-110 group-hover:-rotate-6 sm:h-12 sm:w-12 sm:rounded-2xl">
                <Icon name={v.icon} class="h-[20px] w-[20px] sm:h-[22px] sm:w-[22px]" />
              </span>
              <span class="font-mono text-[0.68rem] text-faint">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-auto pt-8 font-display text-[1.2rem] leading-[1.1] font-semibold sm:pt-10 sm:text-[1.5rem]">{v.title}</h3>
            <p class="mt-2 text-[0.8rem] leading-relaxed text-muted sm:min-h-[3.2em] sm:text-[0.9rem]">{v.desc}</p>
          </li>
        ))
      }
    </ul>
    {
      cta && (
        <div class="mt-14 flex justify-center" data-reveal>
          <button type="button" class="btn btn-lg btn-grad" data-wa={cta.wa} data-magnetic>
            <span>{cta.label}</span>
            <Icon name="ArrowUpRight" class="btn-icon" />
          </button>
        </div>
      )
    }
  </div>
</section>
<style>
  .vendor-icon { background: linear-gradient(140deg, rgb(255 61 129 / 0.22), rgb(255 122 47 / 0.12)); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1); }
</style>
