---
import { nav, wa, site } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import Monogram from './Monogram.astro';
import { u } from '../lib/url';

interface Props { current: string; drawerWa?: string }
const { current, drawerWa = wa.drawer } = Astro.props;
---
<header class="site-nav fixed inset-x-0 top-0 z-50" data-nav>
  <div class="shell">
    <div class="nav-bar mt-3 flex h-[60px] items-center justify-between rounded-full pr-2 pl-2.5 transition-[background-color,box-shadow,backdrop-filter] duration-700 ease-(--ease-expo)" data-nav-bar>
      <a href={u('/')} class="group flex items-center gap-3" aria-label="Reviere Events — Home">
        <Monogram class="h-10 w-10 text-[0.95rem] transition-transform duration-700 ease-(--ease-expo) group-hover:scale-110" />
        <span class="flex flex-col leading-none">
          <span class="font-display text-[1.15rem] font-semibold tracking-tight">REVIERE</span>
          <span class="mt-1 font-mono text-[0.58rem] tracking-[0.38em] text-muted">EVENTS</span>
        </span>
      </a>

      <nav class="hidden md:block" aria-label="Primary">
        <ul class="relative flex items-center gap-1 rounded-full p-1" data-nav-links>
          <li aria-hidden="true" class="nav-pill pointer-events-none absolute top-1 left-0 h-[calc(100%-0.5rem)] rounded-full bg-fg opacity-0" data-nav-pill></li>
          {
            nav.map((n) => (
              <li class="relative">
                <a href={u(n.href)} class="nav-link relative z-10 block rounded-full px-4 py-2 text-[0.9rem] font-medium transition-colors duration-500" aria-current={current === n.key ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <button type="button" class="btn btn-sm btn-wa hidden sm:inline-flex" data-wa={wa.nav} data-magnetic>
          <BrandIcon name="whatsapp" class="h-4 w-4" />
          <span>WhatsApp</span>
        </button>
        <button type="button" class="menu-toggle relative grid h-11 w-11 place-items-center rounded-full bg-fg text-bg md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer" data-menu-toggle>
          <span class="menu-line absolute h-px w-4 bg-current transition-transform duration-500 ease-(--ease-expo)" style="transform: translateY(-3px)"></span>
          <span class="menu-line absolute h-px w-4 bg-current transition-transform duration-500 ease-(--ease-expo)" style="transform: translateY(3px)"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-drawer" class="drawer fixed inset-0 z-40 bg-bg md:hidden" data-drawer aria-hidden="true" inert>
  <div class="aurora absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="shell relative flex h-full flex-col pt-28 pb-10">
    <nav aria-label="Mobile">
      <ul class="flex flex-col">
        {
          nav.map((n, i) => (
            <li class="drawer-item overflow-hidden border-b border-white/10" style={`--i:${i}`}>
              <a href={u(n.href)} class="flex items-baseline justify-between py-4" aria-current={current === n.key ? 'page' : undefined}>
                <span class="font-display text-[3rem] leading-none font-semibold tracking-tight uppercase">{n.label}</span>
                <span class="font-mono text-xs text-muted">0{i + 1}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="drawer-item mt-auto space-y-5" style="--i:5">
      <button type="button" class="btn btn-grad btn-lg btn-block" data-wa={drawerWa}>
        <BrandIcon name="whatsapp" class="h-5 w-5" />
        <span>Chat on WhatsApp</span>
      </button>
      <div class="flex items-center justify-between font-mono text-xs text-muted">
        <a href={site.mainPhone.href}>{site.mainPhone.label}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .nav-link { color: var(--color-fg); }
  .nav-link.is-pill { color: #0a0a0a; }
  [data-nav].is-scrolled .nav-bar,
  [data-nav].is-solid .nav-bar {
    background: rgb(14 14 19 / 0.86);
    backdrop-filter: blur(20px) saturate(1.5);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08), 0 16px 40px -20px rgb(0 0 0 / 0.8);
  }
  .nav-pill { transition: transform 0.6s var(--ease-expo), width 0.6s var(--ease-expo), opacity 0.4s; }

  .drawer { clip-path: inset(0 0 100% 0); transition: clip-path 0.9s var(--ease-expo); visibility: hidden; }
  .drawer.is-open { clip-path: inset(0 0 0 0); visibility: visible; }
  .drawer .drawer-item { opacity: 0; transform: translateY(24px); transition: opacity 0.7s var(--ease-expo), transform 0.9s var(--ease-expo); }
  .drawer.is-open .drawer-item { opacity: 1; transform: none; transition-delay: calc(var(--i) * 60ms + 200ms); }
  [data-menu-toggle][aria-expanded='true'] .menu-line:first-child { transform: rotate(45deg) !important; }
  [data-menu-toggle][aria-expanded='true'] .menu-line:last-child { transform: rotate(-45deg) !important; }
</style>
